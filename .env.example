# Postgres
POSTGRES_USER=moss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moss
DATABASE_URL=postgres://moss:change-me@localhost:5432/moss

# Path to the master key used by the secrets broker (generated on first boot by deploy/init.sh)
MOSS_MASTER_KEY_FILE=./deploy/secrets/master.key

# HTTPS (see deploy/docker-compose.yml). deploy/init.sh switches it on for new installs.
# COMPOSE_PROFILES=https
# MOSS_TLS=internal                       # or "files" for your own certificate in deploy/certs
# The starting names and IPs MOSS answers to; after the first start, change them in Settings → HTTPS.
# MOSS_HTTPS_HOSTS=localhost, 192.168.1.20, moss.lan
# MOSS_HTTPS_DEFAULT_NAME=192.168.1.20      # the address browsers use when they connect by IP
# MOSS_HTTPS_PORT=443

# Reach MOSS from anywhere over Tailscale (https://moss.<tailnet>.ts.net, a real certificate, no open ports):
# add tailscale to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=https,tailscale) and an auth key from the Tailscale
# admin console (Settings > Keys > Generate auth key). After the first start the key is no longer needed.
# MOSS_TAILSCALE_AUTHKEY=tskey-auth-...
# MOSS_TAILSCALE_HOSTNAME=moss
