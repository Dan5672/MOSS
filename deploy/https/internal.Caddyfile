# HTTPS managed from MOSS (the default). Either MOSS's own certificate authority (Caddy creates a private
# CA the first time it starts and issues certificates for the names and addresses in MOSS_HTTPS_HOSTS;
# devices trust it once via /moss-ca.crt), or a certificate uploaded in Settings → HTTPS. Which one is in
# /tls/web/tls.caddy, written by the web app; it restarts Caddy through the admin socket beside it, which
# only the web app and Caddy can reach. Nothing is sent to the internet.
{
	admin "unix//tls/web/admin.sock|0666"
	https_port 8443
	auto_https disable_redirects
	# Clients connecting by IP address (https://192.168.1.20) send no server name; they get this one's certificate.
	default_sni {$MOSS_HTTPS_DEFAULT_NAME:localhost}
	local_certs
	skip_install_trust
	pki {
		ca local {
			name "MOSS Local CA"
		}
	}
}

import /etc/caddy/moss.caddy

{$MOSS_HTTPS_HOSTS:localhost} {
	import /tls/web/tls.caddy
	# The CA certificate, for devices to trust once (it's public; it's what makes the padlock work).
	handle /moss-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=moss-ca.crt"
		file_server
	}
	import moss
}

# Inside Docker only (not published): the CA certificate for MOSS's web app, which shows its fingerprint.
http://:8080 {
	handle /moss-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	respond 404
}
