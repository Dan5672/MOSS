{
  "name": "@moss/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./library": {
      "types": "./dist/library-sync.d.ts",
      "default": "./dist/library-sync.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=30000"
  },
  "dependencies": {
    "@moss/core": "workspace:*",
    "@moss/db": "workspace:*",
    "@moss/llm": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "pg-boss": "^12.36.0"
  }
}
