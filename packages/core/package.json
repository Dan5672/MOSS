{
  "name": "@moss/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/monitoring/metrics.d.ts",
      "default": "./dist/monitoring/metrics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=30000"
  },
  "dependencies": {
    "@moss/db": "workspace:*",
    "@moss/policy": "workspace:*",
    "@moss/tools": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "zod": "^4.6.5"
  }
}
